# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.python-version

# ---- 构建产物 / 安装包 ----
build/
dist/
output/
deploy/output/
*.spec.bak
*.exe
*.msi
deploy/nssm.exe

# ---- 运行时数据与密钥（严禁入库）----
logs/
*.log
database/*.db
database/*.db-shm
database/*.db-wal
database/backups/
database/.flask_secret
database/.secret.key
database/.secret.key.bak
*.secret
*.key
*.pem
*.pfx
.env
.env.*
!.env.example

# ---- 临时文件 ----
tmp/
temp/
*.tmp
*.bak
~$*

# ---- IDE / 系统 ----
.vs/
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---- 发布产物例外 ----
# 安装包与文档统一走 GitHub Releases 分发（单个 exe 约 25 MB，不入 git 历史）；
# 仓库内只保留 dist/<版本>/README.md 作为说明与校验值，其余一律忽略。
!dist/
dist/*
!dist/v1.0.3/
dist/v1.0.3/*
!dist/v1.0.3/README.md
